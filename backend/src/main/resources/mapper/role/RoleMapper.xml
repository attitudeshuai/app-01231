<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.module.role.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.library.module.role.entity.Role">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="description" property="description"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, role_name, role_code, description, created_at
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM roles WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM roles ORDER BY created_at DESC
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM roles
        <where>
            <if test="params.roleName != null and params.roleName != ''">
                AND role_name LIKE CONCAT('%', #{params.roleName}, '%')
            </if>
            <if test="params.roleCode != null and params.roleCode != ''">
                AND role_code = #{params.roleCode}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM roles
        <where>
            <if test="params.roleName != null and params.roleName != ''">
                AND role_name LIKE CONCAT('%', #{params.roleName}, '%')
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*) FROM roles
        <where>
            <if test="params.roleName != null and params.roleName != ''">
                AND role_name LIKE CONCAT('%', #{params.roleName}, '%')
            </if>
        </where>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO roles (role_name, role_code, description, created_at)
        VALUES (#{roleName}, #{roleCode}, #{description}, NOW())
    </insert>

    <insert id="batchInsert">
        INSERT INTO roles (role_name, role_code, description, created_at)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.roleName}, #{item.roleCode}, #{item.description}, NOW())
        </foreach>
    </insert>

    <update id="updateById">
        UPDATE roles
        <set>
            <if test="roleName != null">role_name = #{roleName},</if>
            <if test="roleCode != null">role_code = #{roleCode},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM roles WHERE id = #{id}
    </delete>

    <delete id="deleteBatchIds">
        DELETE FROM roles WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="exists" resultType="boolean">
        SELECT COUNT(*) > 0 FROM roles
        <where>
            <if test="params.id != null">AND id = #{params.id}</if>
            <if test="params.roleCode != null">AND role_code = #{params.roleCode}</if>
        </where>
    </select>

    <select id="selectByRoleCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM roles WHERE role_code = #{roleCode}
    </select>

    <select id="selectPermissionIdsByRoleId" resultType="long">
        SELECT permission_id FROM role_permissions WHERE role_id = #{roleId}
    </select>

    <insert id="insertRolePermission">
        INSERT INTO role_permissions (role_id, permission_id) VALUES (#{roleId}, #{permissionId})
    </insert>

    <delete id="deleteRolePermissions">
        DELETE FROM role_permissions WHERE role_id = #{roleId}
    </delete>

    <select id="countUsersByRoleId" resultType="int">
        SELECT COUNT(*) FROM user_roles WHERE role_id = #{roleId}
    </select>
</mapper>
